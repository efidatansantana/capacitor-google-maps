{
  "compilerOptions": {
    "allowUnreachableCode": false,
    "declaration": true,
    "declarationDir": "dist/typings",
    "esModuleInterop": true,
    "inlineSources": true,
    "lib": [
      "dom",
      "es2017"
    ],
    "module": "esnext",
    "moduleResolution": "node",
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "dist/esm",
    "pretty": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "resize-observer-browser",
      "supercluster",
      "google.maps"
    ],
    "target": "es2017"
  },
  "files": [
    "src/index.ts"
  ]
}